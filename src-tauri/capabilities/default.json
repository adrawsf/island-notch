{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the notch, mini player, teleprompter and settings windows",
  "windows": ["main", "miniplayer", "teleprompter", "settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "store:default"
  ]
}
